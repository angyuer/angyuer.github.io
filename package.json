{
  "name": "angyuer-blog",
  "version": "1.0.0",
  "private": true,
  "description": "昂予的技术、日记与项目记录",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "hexo server --draft",
    "server": "hexo server",
    "build": "npm run sync:vendor && npm run optimize:images && npm run check && hexo clean && hexo generate",
    "clean": "hexo clean",
    "check": "node tools/check-content.mjs",
    "check:env": "node tools/check-env.mjs",
    "check:html": "node tools/check-html.mjs public",
    "check:links": "node tools/check-links.mjs public",
    "check:assets": "node tools/check-assets.mjs public",
    "check:lighthouse": "node tools/check-lighthouse.mjs",
    "test:smoke": "playwright test tests/site.spec.mjs",
    "test:visual": "playwright test tests/visual.spec.mjs",
    "test:visual:update": "UPDATE_VISUAL_BASELINES=1 playwright test tests/visual.spec.mjs",
    "verify": "npm run check:env && npm run build && npm run check:html && npm run check:links && npm run check:assets && npm run test:smoke && npm run test:visual && npm run check:lighthouse",
    "new:tech": "node tools/new-content.mjs tech",
    "new:journal": "node tools/new-content.mjs journal",
    "new:project": "node tools/new-content.mjs project",
    "optimize:images": "node tools/optimize-images.mjs",
    "prepare:hero": "node tools/prepare-hero.mjs",
    "sync:vendor": "node tools/sync-vendor.mjs",
    "deploy": "hexo deploy"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "hexo": "8.1.2",
    "hexo-abbrlink": "2.2.1",
    "hexo-deployer-git": "4.0.0",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-searchdb": "1.5.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-pug": "3.0.0",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-wordcount": "6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "cheerio": "1.2.0",
    "chrome-launcher": "1.2.1",
    "gray-matter": "4.0.3",
    "lighthouse": "13.4.1",
    "sharp": "0.35.3"
  }
}
