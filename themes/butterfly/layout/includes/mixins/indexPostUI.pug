mixin indexPostUI()
  #recent-posts.recent-posts.nc(data-filtered='all')
    .recent-post-items
      each article, index in page.posts.data
        - const channel = article.channel || 'tech'
        - const channelLabels = { tech: '技术', journal: '日记', project: '项目' }
        - const link = article.link || article.path
        - const title = article.title || _p('no_title')
        - const cover = article.cover || theme.cover.default_cover
        - const tags = article.tags && article.tags.data ? article.tags.data.slice(0, 2) : []
        - const cardClass = index === 0 ? 'is-lead' : index === page.posts.data.length - 1 ? 'is-wide' : 'is-compact'
        article.recent-post-item(class=cardClass data-channel=channel)
          a.post-card__cover(href=url_for(link) title=title tabindex='-1' aria-hidden='true')
            img(src=url_for(cover) alt='' loading=index < 4 ? 'eager' : 'lazy' decoding='async')
          .recent-post-info
            .article-row-meta
              span.article-index(aria-hidden='true')=String(index + 1).padStart(2, '0')
              span.channel-label=channelLabels[channel] || channelLabels.tech
              span(aria-hidden='true') ·
              time(datetime=date_xml(article.updated || article.date))=date(article.updated || article.date, config.date_format)
            a.article-title(href=url_for(link) title=title)
              if globalPageType === 'home' && (article.top || article.sticky > 0)
                i.fas.fa-thumbtack.sticky
              = title
            - const content = article.summary || postDesc(article)
            if content
              if article.summary
                .content=content
              else
                .content!=content
            .post-card__footer
              if tags.length
                .post-card__tags(aria-label='文章标签')
                  each tag in tags
                    span= '# ' + tag.name
              a.post-card__more(href=url_for(link) title=`阅读《${title}》` aria-label=`阅读《${title}》`)
                i.fas.fa-arrow-right(aria-hidden='true')

        if theme.ad && theme.ad.index
          if (index + 1) % 3 === 0
            .recent-post-item.ads-wrap!= theme.ad.index

    include ../pagination.pug
