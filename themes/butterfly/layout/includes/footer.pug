- const currentYear = new Date().getFullYear()
- const sinceYear = theme.footer.owner.since
.footer-inner
  nav.footer-links(aria-label='页脚导航')
    a(href=url_for('/about/')) 关于
    a(href=url_for('/archives/')) 归档
    a(href=url_for('/tags/')) 标签
    a(href=url_for('/images/')) 图片
    a(href=url_for('/music/')) 音乐
    a(href=url_for('/movies/')) 电影
    a(href=url_for('/link/')) 友链
    a(href=url_for('/atom.xml')) RSS
  .footer-copyright
    if sinceYear && sinceYear != currentYear
      != `&copy;&nbsp;${sinceYear} - ${currentYear} ${config.author}`
    else
      != `&copy;&nbsp;${currentYear} ${config.author}`
