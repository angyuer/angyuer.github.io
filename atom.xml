  <entry>
    <author>
      <name>昂予</name>
    </author>
    <category term="技术" scheme="https://angyuer.com/categories/%E6%8A%80%E6%9C%AF/"/>
    <category term="Cocos Creator" scheme="https://angyuer.com/tags/Cocos-Creator/"/>
